"rhythm.perch" = "Two close taps, then a long rest.";
"rhythm.whitefish" = "Three even notes at the same pitch.";
"rhythm.char" = "Two taps with a wide gap, then one close tap.";
"rhythm.pike" = "One low tap, then two quick high taps.";
"rhythm.roach" = "Four taps in two pairs.";
"rhythm.bream" = "Two descending notes, a rest, then two rising notes.";
"rhythm.burbot" = "Three low taps, with a longer gap before the last.";
"rhythm.grayling" = "Five quick taps; the last two fall.";
"brief.double" = "Drag the orange hydrophone to a hole. Tune out the hiss, then pin the same double knock at two holes. Compare their levels before you choose a rig.";
"brief.third" = "Find the three notes from yesterday’s recording. The source is still, so you can compare all three holes on the same watch.";
"brief.ledge" = "The ledge drops away under the ice. Compare the same rhythm in shallow and deep water, then choose where to set the lure.";
"brief.copper" = "A metal fitting rings at one hole in the shallows. Change depth and look for a living rhythm among the cleaner readings.";
"brief.pass" = "One stop per minute on the loop A → B → C → D. Pin the crest at two different times. Your lure reaches the water one stop later.";
"brief.hollow" = "Wind throws a sharp reflection into the shallow band. Listen at both depths and compare the pulse spacing with the field guide.";
"brief.schools" = "Two shoals overlap. Find the guide’s four taps in pairs, using depth to separate them from the other rhythm. The fish circle B → C → D.";
"brief.phrase" = "A second transmission rides under the falling and rising notes. Track the stop order D → C → B → A, one stop per minute.";
"brief.deep" = "Under the pier, shallow water only carries a trace. Find the three low taps where the guide says they should be.";
"brief.tangle" = "Look for five quick taps in the shallows. Deep water carries a second rhythm and the strongest stop moves A → C → E.";
"brief.quiet" = "Watch the low three-tap signal travel E → D → C → B → A. Pin two strong readings at different stops to predict where the lure will land.";
"brief.broadcast" = "Join the three phrases in the journal. Compare the joined signal at two holes, then lower the grapnel where it is strongest.";
"brief.survey" = "Use the guide to identify the moving source. It follows the hole letters in order and advances one stop while the lure drops.";
"note.double" = "First entry from Glass Bay. Under the two taps, three evenly spaced notes were waiting.";
"note.third" = "The three notes came from a whitefish. A rigid count-in beneath them sounded like a second station.";
"note.ledge" = "The shallow reading carried the rhythm, but the deep reading brought it into focus.";
"note.copper" = "The lonely metallic tick came from the ice fitting. The live signal had room to breathe between taps.";
"note.pass" = "The watch times made a route out of two readings. The lure met the pike at the next stop.";
"note.hollow" = "The reflection fell away once the hydrophone went below the wind.";
"note.schools" = "The pairs stayed clear once the other shoal dropped out of the depth band.";
"note.phrase" = "The second phrase begins on the same two beats that closed the count-in.";
"note.deep" = "The pilings made a thin echo above the burbot’s broad, low taps.";
"note.tangle" = "The two rhythms shared a hole. Only one kept all five taps in the shallows.";
"note.quiet" = "The last phrase came through after the burbot circled the pier. The three scraps can now be joined.";
"note.broadcast" = "The loop belonged to a sunken practice beacon. The lakes are open for free surveys.";
"note.survey" = "A fresh field entry from familiar ice. Another source is ready to track.";
